# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# 
# For Neon (recommended): Get from https://neon.tech
# For local PostgreSQL: postgresql://postgres:password@localhost:5432/forge_todo
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# ============================================
# Authentication & Security
# ============================================
# JWT secret key for signing tokens
# IMPORTANT: Generate a strong random secret for production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_USER_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ============================================
# Server Configuration
# ============================================
# Port for the backend server (default: 3000)
PORT=3000

# ============================================
# CORS Configuration
# ============================================
# Frontend URL(s) for CORS - comma-separated for multiple origins
# Development: http://localhost:3001
# Production: https://your-app.vercel.app
FRONT_END_URL="http://localhost:3001"

# For multiple origins in production, you can use:
# FRONT_END_URL="https://your-app.vercel.app,https://your-custom-domain.com"
